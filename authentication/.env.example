# Copy to .env; Spring imports it from the Authentication working directory.
CUSTOMER_OTP_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Independent random 32-byte base64 keys. Delivery key must match Notification.
OTP_DIGEST_KEY=
OTP_DELIVERY_KEY=

# Customer password-reset email destination
CUSTOMER_FRONTEND_URL=http://localhost:3000

# See AUTH_SECURITY.md; use matching server-only secrets in the callers.
AUTH_PROXY_TOKEN=
SERVICE_INTERNAL_TOKEN=
NOTIFICATION_SERVICE_URL=http://localhost:4000

# Meta App settings > Basic. Must match the customer frontend credentials.
FACEBOOK_APP_ID=1464244575612713
FACEBOOK_APP_SECRET=a4906c1934bdecf582e58c703fc31122
