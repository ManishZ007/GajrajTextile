# Copy to .env; Spring imports it from the Authentication working directory.
CUSTOMER_OTP_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Independent random 32-byte base64 keys. Delivery key must match Notification.
OTP_DIGEST_KEY=
OTP_DELIVERY_KEY=

# Customer password-reset email destination
CUSTOMER_FRONTEND_URL=http://localhost:3000
